# Many operational values below (the n8n webhook URLs, NEXT_PUBLIC_APP_URL,
# RESUME_SCREENING_INVITE_BASE_URL, N8N_BULK_RESUME_PORTAL_BASE_URL,
# RESUME_STORAGE_DRIVE_FOLDER_ID, GOOGLE_BULK_RESUME_DRIVE_URL,
# ALLOWED_GOOGLE_DOMAIN, BOOKING_LINK_EXPIRY_DAYS,
# RESUME_SCREENING_LINK_EXPIRY_DAYS, BULK_RESUME_UPLOAD_CONCURRENCY,
# BULK_RESUME_NOTIFY_ON_SUCCESS) can also be set at runtime under
# Settings -> Infrastructure. A non-empty Settings value overrides the env var;
# the env var is the first-run default. Bootstrap IDs and every secret below
# stay env-only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
ALLOWED_GOOGLE_DOMAIN=mclinkgroup.com
SESSION_SECRET=replace-with-at-least-32-random-characters
# Reuses GOOGLE_CLIENT_ID above (same OAuth client, "Web application" type)
# for the HOD Google Calendar connection flow. That client needs a secret
# and this exact redirect URI added under "Authorized redirect URIs" in
# Google Cloud Console, plus the Google Calendar API enabled on the project.
# Calendar connections request event creation and free/busy checking; HODs
# must reconnect after the scope changes if they were connected previously.
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-the-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google-calendar/callback
# HR "Connect Google Drive" (resume import) reuses the same OAuth client with a
# separate read-only scope. In Google Cloud Console: add the
# `.../auth/drive.readonly` scope to the OAuth consent screen, enable the
# Google Drive API, and add `<origin>/api/auth/google-drive/callback` to the
# client's Authorized redirect URIs. The redirect is normally derived from the
# request origin; this is only a fallback for non-request server callers.
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google-drive/callback
# HR "Connect OneDrive" (resume import) — a wholly separate Microsoft Entra app
# registration, unrelated to any Google credential. Register an app at
# https://entra.microsoft.com (App registrations), add a Web redirect URI
# `<origin>/api/auth/microsoft-drive/callback`, add a client secret, and grant
# the delegated Microsoft Graph permissions `Files.Read`, `User.Read`,
# `offline_access`. MS_TENANT_ID: your directory (tenant) ID, or `organizations`
# for any work/school account, or `common`. Leave MS_CLIENT_ID/MS_CLIENT_SECRET
# blank to hide the OneDrive option entirely. The redirect is normally derived
# from the request origin; MS_DRIVE_OAUTH_REDIRECT_URI is a fallback only.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=organizations
MS_DRIVE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/microsoft-drive/callback
# Server-only n8n endpoints and secret. The browser must never receive these.
N8N_ROLE_WEBHOOK_URL=https://your-n8n-domain/webhook/role-request
N8N_ROLE_REQUEST_WEBHOOK_URL=https://your-n8n-domain/webhook/role-request
N8N_ROLE_DESCRIPTION_PARSER_WEBHOOK_URL=https://your-n8n-domain/webhook/role-description-parser
N8N_RECRUITMENT_SETUP_WEBHOOK_URL=https://your-n8n-domain/webhook/recruitment-setup
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret
N8N_CANDIDATE_APPLICATION_WEBHOOK_URL=https://your-n8n-domain/webhook/candidate-application
# Max time to wait for the (currently synchronous) AI CV screening workflow
# before failing the request. Default 60000.
N8N_CANDIDATE_APPLICATION_TIMEOUT_MS=60000
# Per-file timeout for the bulk resume screening webhook. One stuck n8n
# execution fails that single file; the rest of the batch continues. Default 60000.
N8N_BULK_RESUME_TIMEOUT_MS=60000
# Server-only endpoint used by “Generate & send email”. It receives the
# invitation details and sends the message through the configured mail account.
N8N_APPLICATION_INVITE_EMAIL_WEBHOOK_URL=https://your-n8n-domain/webhook/application-invite-email
N8N_BULK_RESUME_UPLOAD_WEBHOOK_URL=https://your-n8n-domain/webhook/bulk-resume-upload
# How many resumes the bulk upload route processes at once (1-10). Raise this
# only after confirming the connected OpenAI/Google Sheets quota has headroom
# — each concurrent file runs its own AI extraction + screening chain.
BULK_RESUME_UPLOAD_CONCURRENCY=5
# Internal "batch complete" HR/management email sent after a bulk upload
# finishes. Off by default while bulk screening is being rolled out; set to
# "true" to re-enable it.
BULK_RESUME_NOTIFY_ON_SUCCESS=false
# Leave blank normally. Set a unique value only during an explicitly approved
# Production canary; this labels the batch but does not reroute Production data.
BULK_RESUME_PRODUCTION_UAT_BATCH_ID=
# Shared Google Drive destination for the bulk resume screening panel.
GOOGLE_BULK_RESUME_DRIVE_URL=https://drive.google.com/drive/folders/your-bulk-resume-folder-id
# Folder ID used by the n8n Drive poller; configure this in the n8n environment.
GOOGLE_BULK_RESUME_DRIVE_FOLDER_ID=your-bulk-resume-folder-id
# Public portal origin reachable by n8n for PDF/DOCX text extraction.
N8N_BULK_RESUME_PORTAL_BASE_URL=https://your-portal-domain
# Candidate-facing index.html used in HR-generated invite links.
# The supplied file is kept unchanged. If only the site origin is provided,
# the portal adds /index.html automatically.
RESUME_SCREENING_INVITE_BASE_URL=https://your-portal-domain/index.html
# Bulk UAT is fail-closed: these must point to a dedicated UAT folder and
# dedicated UAT workbook containing the mirrored bulk/result tabs.
BULK_RESUME_UAT_MODE=false
BULK_RESUME_UAT_DRIVE_FOLDER_ID=
BULK_RESUME_UAT_SPREADSHEET_ID=
# Required in UAT mode so Preview cannot call the Production intake webhook.
N8N_BULK_RESUME_UPLOAD_UAT_WEBHOOK_URL=
N8N_BULK_RESUME_UAT_WEBHOOK_SECRET=
# Google Sheets service-account configuration; keep the private key server-only.
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
# Optional separate workbook for the ELLA applicant pipeline.
GOOGLE_CANDIDATE_SPREADSHEET_ID=your-candidate-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_APP_NAME=McLink Recruitment Portal
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Final booking tokens are single-use; this controls the initial pending lifetime.
BOOKING_LINK_EXPIRY_DAYS=7
# Private storage for uploaded PDF/DOC/DOCX resumes, backed by Google Drive
# (not local disk — Vercel's filesystem is read-only outside /tmp). Share this
# folder with GOOGLE_SERVICE_ACCOUNT_EMAIL (Editor access) before setting this
# — a Shared Drive folder is strongly preferred, since a service account has
# no storage quota of its own and uploads fail without one.
RESUME_STORAGE_DRIVE_FOLDER_ID=
# Client-demo mode. When "true", the portal shows synthetic recruitment history
# while still accepting new role requests and applicants after DEMO_CUTOFF.
# New records after the cutoff may complete the workflow, including applicant
# email/call/booking/calendar actions; historical records remain protected.
DEMO_MODE=false
# Optional legacy cutoff retained for compatibility with older integrations.
DEMO_CUTOFF=2026-08-20T00:00:00+08:00

# --- Phase 2 backend migration (Postgres) ---
# Neon Postgres connection string. Leave blank to keep everything on Google
# Sheets. Required once CREDITS_BACKEND is dual or postgres, and for the
# HitPay payments feature and the internal recruitment API.
DATABASE_URL=
# Ella Credits storage backend: sheets (default) | dual | postgres.
#   sheets   - the original Google Sheet ledger.
#   dual     - Sheets authoritative; every write mirrored to Postgres and any
#              divergence logged. Use this to soak-test before cutting over.
#   postgres - Neon Postgres authoritative (atomic balance, no overspend).
# See docs/PHASE-2-BACKEND-MIGRATION.md for the cutover/rollback sequence.
CREDITS_BACKEND=sheets

# Recruitment target routing is intentionally dormant by default. Set this to
# `postgres` only as a separately reviewed Pilot cutover action; leave unset
# while preparing target APIs and inactive n8n workflows.
# RECRUITMENT_BACKEND=postgres

# --- Ella (in-portal FAQ help assistant) ---
# Server-only OpenAI API key for the "Ella" chat widget. The browser never
# receives this (read only in src/app/api/help-bot/route.ts; not a NEXT_PUBLIC_
# var). When blank the widget is unavailable/hidden and makes no API call. Add
# the key later and redeploy to make the feature available.
OPENAI_API_KEY=
# Optional model override. Default: gpt-4o-mini (low-cost, fast, sufficient for
# grounded FAQ answers). The help bot answers only from
# src/lib/help-bot/knowledge.md — see docs/ELLA-HELP-BOT.md.
HELP_BOT_MODEL=gpt-4o-mini
# Hard kill switch. Set to "false" to fully hide and disable the widget
# regardless of the key.
HELP_BOT_ENABLED=true

# --- Ella Credits: credits ledger workbook ---
# The Google Sheet that holds the `Ella_Credit_Ledger` tab. Historically this
# was assumed to be GOOGLE_SHEETS_SPREADSHEET_ID; set this explicitly when the
# ledger lives in a different workbook (e.g. after a pilot/prod spreadsheet
# split). Falls back to GOOGLE_SHEETS_SPREADSHEET_ID when blank. Used by the
# app, `npm run db:backfill:credits`, and `npm run db:check:credits`.
GOOGLE_CREDITS_SPREADSHEET_ID=

# --- Ella Credits: HitPay payments (sandbox for the pilot) ---
# Server-only. When either key is blank the "Buy credits" flow returns
# NOT_CONFIGURED (503) and nothing half-works. Requires DATABASE_URL too.
HITPAY_API_KEY=
HITPAY_SALT=
# "sandbox" (default) | "live". Optional explicit API base override. The value
# must include `/v1`; use the sandbox value below for the pilot.
HITPAY_MODE=sandbox
HITPAY_API_URL=https://api.sandbox.hit-pay.com/v1
# Optional JSON array overriding the built-in credit packs. Same shape as
# src/lib/credit-packs.ts DEFAULT_PACKS; a malformed value is ignored.
ELLA_CREDIT_PACKS=

# --- Internal recruitment API (n8n / Vapi, no DB credentials in n8n) ---
# Shared bearer secret for /api/internal/recruitment/*. Blank = the endpoints
# return 503. n8n sends it as `Authorization: Bearer <secret>`.
INTERNAL_API_SECRET=
# Comma-separated entities served live from Postgres. Unknown/unlisted entities
# fail closed; the global "all" bypass is not supported.
INTERNAL_API_ENTITIES=roles,applicants,applications,screening,screening_invitations,booking,status_history,notifications,voice_attempts,voice_logs,bulk_queue,voice_queue,voice_results,hr_decisions
